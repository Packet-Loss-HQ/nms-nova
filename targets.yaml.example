# Copy this file to targets.yaml and replace placeholder values with your own hosts.
defaults:
  probe_ssh_key: /opt/nms-nova/secrets/nms-probe

targets:
  - name: host-01
    kind: ssh
    address: HOST_IP
    probe_type: ssh
    tier: T1
    ssh_key: ${probe_ssh_key}
    metrics:
      - name: cpu_usage_percent
        interval_sec: 30
      - name: memory_used_percent
        interval_sec: 30
      - name: disk_root_used_percent
        interval_sec: 60
      - name: service_up
        interval_sec: 30
        service_name: svc-a.service
      - name: interface_total_kbps
        interval_sec: 30
        interface: eth0

  - name: host-02
    kind: ssh
    address: HOST_IP
    probe_type: ssh
    tier: T1
    ssh_key: ${probe_ssh_key}
    metrics:
      - name: cpu_usage_percent
        interval_sec: 30
      - name: memory_used_percent
        interval_sec: 30
      - name: disk_root_used_percent
        interval_sec: 60
      - name: service_up
        interval_sec: 30
        service_name: svc-b.service
      - name: interface_total_kbps
        interval_sec: 30
        interface: eth0

  - name: host-03
    kind: ssh
    address: HOST_IP
    probe_type: ssh
    tier: T2
    ssh_key: ${probe_ssh_key}
    metrics:
      - name: cpu_usage_percent
        interval_sec: 60
      - name: memory_used_percent
        interval_sec: 60
      - name: disk_root_used_percent
        interval_sec: 120
      - name: service_up
        interval_sec: 60
        service_name: svc-c.service
      - name: interface_total_kbps
        interval_sec: 60
        interface: eth0

  - name: host-04
    kind: ssh
    address: HOST_IP
    probe_type: ssh
    tier: T2
    ssh_key: ${probe_ssh_key}
    metrics:
      - name: cpu_usage_percent
        interval_sec: 60
